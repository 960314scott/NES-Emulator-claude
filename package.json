{
  "name": "nes-emulator",
  "version": "1.0.4",
  "description": "Cycle-accurate-oriented NES emulator (runs AccuracyCoin)",
  "main": "main.js",
  "author": "960314scott",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.960314scott.nes-emulator",
    "productName": "NES-Emulator",
    "files": [
      "main.js",
      "index.html",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "artifactName": "NES-Emulator-${version}.exe"
    }
  }
}
